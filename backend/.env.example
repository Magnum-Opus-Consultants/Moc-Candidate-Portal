# Copy to .env and adjust. .env is git-ignored; this file is not.
DJANGO_SECRET_KEY=replace-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Where the front end is, for post-sign-in redirects.
DJANGO_FRONTEND_URL=http://localhost:3000

# Sign In with LinkedIn (OpenID Connect). Create a LinkedIn developer app,
# add the "Sign In with LinkedIn using OpenID Connect" product, and register
# the redirect URL below as an authorised redirect URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8002/api/auth/linkedin/callback/

# Sign in with Google (OpenID Connect). No API needs enabling in the Cloud
# console — sign-in is not a Google API. Create an OAuth client ID of type
# "Web application" under Credentials, with the redirect URI below registered,
# and keep the consent screen to the openid/email/profile scopes so it needs
# no verification review.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8002/api/auth/google/callback/
